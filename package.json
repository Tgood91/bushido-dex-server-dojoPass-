{
  "name": "bushido-dex-server-dojopass",
  "private": true,
  "version": "1.0.0",
  "description": "Dojo Pass DNA trait service: living ERC-721 metadata and SVG for Dojo Pass holders",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "tsx src/server.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "contracts:build": "node .claude/skills/solidity-verify/scripts/build.mjs"
  },
  "dependencies": {
    "express": "4.22.3",
    "viem": "2.21.53"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.1",
    "tsx": "4.23.15",
    "typescript": "5.7.2"
  }
}
